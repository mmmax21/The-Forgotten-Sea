extends RefCounted
const Lines := preload("res://scripts/story/village_story.gd")
static func opening(s) -> Array:
 var text: Array=["你带着集市留下的问题来到旧学城：如果海洋曾经存在，书里为什么找不到它？" if not s.origin.is_empty() else "你来到旧学城，想从旧书里找一找大海的踪迹。", "藏书馆门口，二笔正把旧书装进木箱。一本书滑到地上，露出一张港口图：船停在岸边，旁边排着仓房。新版却把这里写成了‘内河货站’。", "墨先生|这页我校对过。原来写的是海港，怎么变成河边了？", "高帽子|旧版地名已经停用。第五天审议后统一采用新版，不要再把旧稿混进去。", "二笔|可图上的船，也要跟着改成河船吗？", "墨先生拾起书页，看见角落的校对签名，没有再说下去。", "你有五天，每天3 AP。第三天末停止普通调阅，第四天末清理未保全的旧稿，第五天审议新版。先查清这本书改了什么，再决定怎样把发现留下来。", "第一步：找到这本书的新旧版本。可以请墨先生帮忙，也可以自己查公共目录。"]
 text.append_array(s.events)
 var result := Lines.lines(text)
 result[1]["illustration"] = "harbor"
 return result
static func stage(s) -> Dictionary:
 if s.finished: return {"title":"旧书留下了什么？","next":"查看调查结果与人物处境，再前往羽之森。已经取得的材料和已经发生的传播都会保留。"}
 if s.archive_closed and (not s.has("versions") or not s.has("execution")):
  return {"title":"旧稿已经清理","next":"缺少的旧书或换书记录已无法补取，这次不能查清完整经过。还可以整理手中发现，结束第五天后离城。"}
 if not s.has("versions"):
  return {"title":"找到被改过的那一页","next":"今天是抢救旧书的最后机会：已有目录位置，可以在公共调查花2 AP抢救；不知道位置就无法临时找到旧书。" if s.day==4 else "先取得新旧两版《海港篇》：找墨先生帮忙，或在公共调查查目录、取书。"}
 if not s.has("verify"): return {"title":"同一件事，为什么写法变了？","next":"在公共调查选择“比一比这本书改了哪些地方”。核对同一年、同一批货物，看看改动集中在哪里。"}
 if not s.has("execution"):
  return {"title":"旧书被谁收走了？","next":"今天只能按已知位置花2 AP抢救换书记录；已有的书页不会被收回。" if s.day==4 else "下一步查旧书的去向。请二笔找换书记录，或自己从公共目录查交接位置。"}
 if not s.has("rules"): return {"title":"是谁要求这样换书？","next":"多处藏书馆换了同一批书。去公共调查“找到要求改书的通知”，查它们是否收到同样的要求。"}
 if not s.has("trace"): return {"title":"把这件事查完整","next":"书页、换书记录、通知已经齐了。到公共调查把三份证据连起来，确认改了什么、怎样换掉、依据什么通知。"}
 if not s.success(): return {"title":"证据齐了，要让它去哪里？","next":"选择一种成果：交给读者并讲清经过；申请在第五天当众提出证据；或找高帽子正式登记异议。任选一种即可，也可组合。"}
 if s.has("rescue_extra") and s.warnings.has("er"): return {"title":"先处理二笔的追查风险","next":"额外札记已经保住，二笔仍有未到期的预警。可找她安排保护，避免之后无法继续协助。"}
 return {"title":"真相已经留下痕迹","next":"学城基本目标已完成。可查看人物预警、补强海洋实证，或另选一种传播和留档方式；第五天结束后离城。"}
static func greeting(s,who: String) -> Array:
 if s.people[who].closed: return Lines.lines([s.NAMES[who]+"暂时不能再提供新的调阅帮助。已经交出的证据仍在，你可以使用公共档案中尚未关闭的入口。"])
 var text: Array=[]
 match who:
  "mo":
   if s.has("mo_sign"): text=["墨先生|我的名字已经写上了。这回，我会把自己做过的事说清楚。学生只是替我抄书，别让他们替我担责任。"]
   elif s.has("trace"): text=["墨先生|那不是一处地名改错了。我当年的签字，帮他们把整段航海史藏了起来。", "墨先生|如果你准备公开，我愿意说明自己校对过什么。若先把材料匿名留给读者，我也愿意帮忙。"]
   elif s.has("verify"): text=["墨先生|他们说只是统一地名。我签了字，也没有再去看那些被划掉的句子。", "墨先生|你已经看见改动了。还得查这批旧书去了哪里，不能只凭我的一句后悔。"]
   else: text=["墨先生|先别急着说是谁故意的。也许是我当年漏看了。把新旧两版放在一起，我们先查清楚。"]
  "er":
   if s.has("rescue_extra"): text=["二笔|札记保住了，接应和后续联系也安排好了。我会先暂避，证明师姐没有参与开箱的凭据也留下了。" if s.has("er_protect") else "二笔|那份札记救出来了。开箱的记录还在，他们会顺着交接单查到我和师姐。第五天结束前，我们得安排好暂避和后续联系。"]
   elif s.has("execution"): text=["二笔|我原来只想把整箱书搬走。现在看见这些签名，才知道他们会顺着箱子找到谁。", "二笔|我师姐以前替墨先生抄书，现在又被要求签旧稿处理单。我们得把命令留下，把无关的人护住。"]
   else: text=["二笔|我想趁他们清理之前把旧书藏起来。我师姐以前替墨先生抄过这些页，现在却要签字把它们送走。", "二笔|不过整箱不见了，他们先问的就是她。你先给我这本书的位置，我找对应的记录。"]
  "gao":
   if s.has("file_full") or s.has("file_limited"): text=["高帽子|你的材料已经登记，有编号可以追查。以后谁说没人提出过异议，你可以拿出这张回执。", "高帽子|但收到材料，不代表官方已经接受结论。这个区别，我必须说清楚。"]
   elif s.has("trace"): text=["高帽子|这些书不是自己变成这样的。我看见你的证据了。", "高帽子|可你准备公开哪些名字？下命令的人，和照着抄写的人，要分清楚。我可以登记异议，不能替上面保证答复。"]
   else: text=["高帽子|旧书也会有错，不能看到一句就拿出去传。", "高帽子|我见过旧档案被当作抓人名单。一个签名，连只是抄写的人也被带走了。你想纠错，就先把来源和责任分清楚。"]
 var result := Lines.lines(text)
 if who=="mo" and s.has("verify"):
  result[0]["illustration"] = "consult"
 return result
static func action(s,id: String) -> Array:
 var text: Array=[]
 match id:
  "mo_help": text=["你和墨先生按年代翻查目录，找到《海港篇》新旧两版的位置。", "墨先生|先找书。是我当年看错了，还是后来有人动过，我都不能躲开。"]
  "locate_versions": text=["公共目录保留着《海港篇》新旧两版的位置。你记下位置，不需要先说服某一位学者。"]
  "mo_versions","get_versions","rescue_versions": text=["旧稿写着海港、离岸船队和海港税册。新版仍是同一年、同样的人和货物，却把海港写成了内河货站。", "你保存了出处和对应书页。现在可以认真比一比，哪些内容变了。"]
  "verify":
   text=["纸张年代和引用顺序对得上。同一件事里，普通贸易内容还在，涉及海洋和远航的句子却被改掉了。", "新版页角留着墨先生的校对签名。签名证明他参与过校对，还不能说明是谁要求改书。"]
   if s.has("mo_help") and not s.people.mo.closed: text.append("墨先生|我以为只是统一地名。是我没有继续问。去查换书记录吧，不能只听我现在怎么说。")
  "er_help": text=["二笔认出你记下的位置，找到这一批书的交接索引。她指着其中一个名字——那是替墨先生抄过书的师姐。", "二笔|她只管抄写、搬运，现在又要签处理单。我们先查是哪批书，别让所有交接的人都卷进来。"]
  "locate_execution": text=["你在公共目录找到这批旧书的交接位置。记录里有抄写、搬运和批准人员，姓名旁写着不同职责。"]
  "er_records","get_execution","rescue_execution":
   text=["三处藏书馆在对应日期换入了同样的新稿，收走的旧书又被集中登记处理。记录上的编号相同，说明是同一批安排。", "这已经不是一本书偶然抄错。下一步要找到要求换书的通知。"]
   if s.has("er_help") and not s.people.er.closed: text.insert(1,"二笔|我师姐的签名在这里，她负责把书交出去。下命令的人却在另一栏。还好我们没有直接把整箱搬走。")
  "rules": text=["你找到一份通知：远航与海港条目改用内河说法，旧稿按指定批次撤换，研究者以后统一采用新版。", "通知、换书记录和书页上的编号可以互相核对。你不需要记住编号，只需要确认它们说的是同一批书。"]
  "trace": text=["你把三份证据排在一起：书页说明改了什么，交接记录说明怎样换掉，通知说明为什么各处一起执行。", "可以确认：海洋历史被有计划地改写，旧书又被集中收走。国王为什么要这样做，仍需要到王城追查。", "证据已经齐了。现在决定怎样把它留下：交给读者、在审议会上提出，或正式登记异议。"]
  "mo_sign": text=["墨先生看过整理好的证据，在关于自己校对工作的说明上签了名。", "墨先生|当年我没有继续追问。这次别删掉我的名字。但学生只是替我抄过书，责任不该推给他们。", "这份证言说明他的参与，不会变成另一份独立海洋物证。公开后他将面对更多追问。"]
  "mo_protect": text=["你与墨先生分清校对、抄写和传递的责任，隐去与调查无关的学生姓名，并约定私人记录的保管方式。", "他承担的校对责任仍然保留，学生不必因此成为新的追查对象。"]
  "er_protect": text=["你保留交接凭据，澄清师姐没有参与额外开箱，请可信的人接应二笔暂时离开藏书馆，再把后续联络交给另一位抄写员。", "二笔|我想救的是书和人。只把书抱出来，还不算做完。"]
  "gao_protect": text=["你向高帽子说明材料的公开范围：追查改书命令，不把普通抄写员当作命令制定者。无关人员的姓名不随公开副本传播。"]
  "rescue_extra": text=["二笔从清理队列中救出一份额外札记，夹页记着羽之森旧观测塔的位置，以及从那里看到的远方水面。", "二笔|这份不在原来的调阅单里。他们会追问是谁开的箱，我们得处理交接人的风险。", "札记已经保住。它提供高塔线索，不替代本章主线证据；二笔的追查风险已经记录。"]
  "gao_help": text=["你向高帽子说明材料来自哪里，以及想追查哪一批换书命令。他允许按这个范围提出申请。", "高帽子|把要查的事写清楚。我给你入口，不等于我已经同意你的判断。"]
  "command": text=["正式命令与这批换书通知对应，说明规定怎样落实到这些藏书馆。更上层为什么作出决定，副本里没有解释。"]
  "file_limited": text=["高帽子收下关于这批改书事件的异议，交给你一张带编号的回执。你的其他材料仍然保留。", "高帽子|这次，你的异议确实进了档案。以后有人说没人提过，你可以拿出它。", "普通居民还没有读到这些材料，因此不会增加公众认知。"]
  "file_full": text=["你把改书经过、命令和附件一起提交，正式要求追查命令的来源。高帽子逐项清点，在回执上写明收到的材料。", "高帽子|我能确认它们被收下，不能承诺上面一定接受结论。这个编号，你留好。", "完整责任材料留下了正式提交记录。这不是公开传播，不会直接增加公众认知。"]
  "protect_copy": text=["你保留能让读者核查的书页、日期和编号，遮去无关人员姓名，整理出几份调查记录。还需要把它们交给读者并讲清经过。"]
  "distribute": text=["几位读者分别收下调查记录。你把新旧书页放在一起，解释内容怎样被改掉、旧书怎样被收走。", "一位读者指着港口图问：‘如果这里真是海港，我祖父说过的那些船，是不是也有可能是真的？’", "你请他保留疑问，也保留可以继续核对的材料。讨论与分散保存已经发生。"]
  "permit": text=["你的发言申请已经登记。第五天审议新版时，还需要花2 AP当众说明证据；今天只是取得发言机会。"]
  "challenge":
   text=["审议会上，你依次摆出旧书、新书、换书记录和通知。有人问这是否只是地名变了，你指出被一起删改的远航内容。"]
   if s.has("mo_sign"):
    text.append("会场读到了墨先生自愿署名的说明：他承认参与校对，也承认当时没有继续追问。" if s.people.mo.closed else "墨先生|那次校对有我的签名。我当时没有继续追问，这个责任我不能再躲。")
   else: text.append("你依据材料说明经过，没有替墨先生公开个人证言，也没有公开无关抄写员的姓名。")
   text.append("高帽子没有当场撤销新版。但学者和学生已经开始讨论，会场无法再当作这些旧书从未存在。")
  "museum": text=["你核对馆藏旧港器具的磨损与使用记录。它们与旧书中的航行用途相符，为文字之外增加了一份实证。"]
  "cross_region": text=["你把随身带来的渔村材料与旧书中的用途对照。生活中留下的痕迹和书中记载能够互相补强，不是同一段文字抄了两遍。"]
  "supplement": text=["你把后来核实的实物依据讲给原来的读者。他们已经知道改书经过，这次只补充新的发现。"]
  "resend": text=["你把整理好的研究记录交给保留下来的集市印刷渠道。明天送达后，才会增加集市的海洋认知。"]
 if id in ["distribute","challenge","supplement"]: text.append("学城公众海洋认知现为%d。" % s.belief)
 text.append(stage(s).next)
 var result := Lines.lines(text)
 if id=="verify":
  result[0]["illustration"] = "compare"
  if s.has("mo_help") and not s.people.mo.closed:
   result[2]["illustration"] = "consult"
 return result
static func departure(s) -> Array:
 var text: Array=s.events.duplicate()
 text.append(s.result_text())
 if s.has("distribute"): text.append("你离开时，读者仍围着那张港口图讨论。旧书可能被清理，但他们手里的调查记录已经留下。")
 if s.has("challenge"): text.append("审议结束，官方版本没有立刻改变，公开提出的证据却留在了听众的讨论里。")
 if s.has("file_limited") or s.has("file_full"): text.append("你把正式回执放进随身材料。它不能代替真相，却证明有人曾经把问题完整地提出来。")
 if s.people.mo.closed: text.append("墨先生已经暂停新的协助。你已取得的材料仍然保留。"+("他的署名说明也仍然有效。" if s.has("mo_sign") else ""))
 elif s.has("trace") and s.has("mo_help"): text.append("墨先生没有再把那次校对称为‘改几个地名’。"+("他的名字已经留在责任说明上。" if s.has("mo_sign") else "即使没有公开署名，他仍帮助你保住了可以核对的旧书。"))
 if s.people.er.closed: text.append("二笔被停职盘问，师姐也被要求接受核查。经她维系的联系受查；已经交出的材料和札记保留。到了羽之森，你仍可托人送出凭据、安排接应。")
 elif s.has("er_protect"): text.append("二笔按约定暂避，师姐未参与额外开箱的凭据已经保留，另一位抄写员接下了后续联系。")
 if s.has("versions"):
  text.append("旧书里还提到：普通羽人曾担任空中信使。如今人们却说，他们一直不能飞。你决定到羽之森继续调查。")
 else: text.append("你没能取得完整旧稿。离城的路通向羽之森，你决定向那里的居民继续打听海洋与过去的生活。")
 if s.has("rescue_extra"): text.append("二笔救出的札记还给出了旧观测塔的位置。到了羽之森，你有一条具体线索可以追。")
 return Lines.lines(text)
static func day_start(s) -> Array:
 var text: Array=s.events.duplicate()
 text.append("学城第%d天，可用%d AP。" % [s.day,s.ap])
 if s.day==2: text.append("馆里又堆起一排待处理的箱子。书页能告诉你改了什么，交接记录才能告诉你旧书去了哪里。")
 if s.day==3: text.append("今晚停止普通旧稿调阅。需要的书页和换书记录，要尽快拿到；明天只能凭已知位置花2 AP定向抢救。")
 if s.day==4: text.append("今天是最后抢救日，晚上清理旧稿。想在明天当众提出证据，也必须今天办好发言申请。已经取得的材料不会消失。")
 if s.day==5: text.append("新版审议今天举行。已经申请发言的人可以当众提出证据；没有席位，也仍可交给读者或正式提交异议。")
 text.append(stage(s).next)
 return Lines.lines(text)
