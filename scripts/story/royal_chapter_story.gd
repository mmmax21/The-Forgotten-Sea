extends RefCounted
const Lines := preload("res://scripts/story/village_story.gd")
static func opening(s) -> Array:
 var text: Array=["王城的钟声压过街头的争论。城门贴着新的告示：六日之后，举行定界大典。", "告示写着：王国之外，没有可抵达的世界。王室将重新确认这一共同认知，并清理未经核验的材料。", "审查官|你从几个地方带来了记录。交代来源，接受问询；我关心的是明天街道上是否还会有人互相搜捕。", "人群后方，一名苍老的羽人反复念着同一个年份。禁令上的签署者、王城的祭司，似乎仍活在那场战争里。", "六天，每天3 AP。第5天末查封未保护的传播节点，第6天作最终选择；海回归与接管各需要最后1 AP；确认解放免费。", "前区认知分别保留。海回归需要渔村独立实证、羽之森证据核实与传播、两个前区已有读者；还需总和80、至少3地达到20、王城达到20，并解除三项控制。取得法器不会自动触发新的王。"]
 var family: String=s.ForestStory.family_text(s.origin,s.prior_contacts)
 if not family.is_empty(): text.append(family)
 text.append_array(s.events)
 return Lines.lines(text)
static func stage(s) -> Dictionary:
 if s.finished: return {"title":s.ENDINGS[s.ending],"next":"查看最终结果与各地留下的改变。可以打开地图查看世界，或重新开始本章尝试另一种选择。"}
 if s.day==6: return {"title":"定界大典 · 最终选择","next":"公共调查中可以查看四种结局及尚缺条件。最终选择前仍可执行行动，但海回归和接管需要保留1 AP；确认解放免费。"}
 if not s.has("archive"): return {"title":"先找到禁令的共同来源","next":"在公共调查查阅禁令总档案。也可先准备传播网络，安排这六天的行动。"}
 if not s.has("chain"): return {"title":"封闭为何开始，又为何延续？","next":"核对战争旧史、调查法器记录，再串联责任链。海洋实证与分散网络可以同步准备。"}
 if s.deal_binding(): return {"title":"有限改革已经执行","next":"释放名单已核验，但王室仍要求你停止传播。若要继续改变体系，先向国王解除承诺，花费1 AP。"}
 if s.network_closed: return {"title":"递送节点被封","next":"过去的认知仍在。公共调查中的转移节点可以恢复未来递送，不需要重做已经发生的传播。"}
 return {"title":"选择怎样改变王国","next":"传播路线：建立网络并说明海洋证据。解放路线：停止集中执行、解除法器独占。祭司路线：共同验证保护方案后争取交付。第4天起可与国王讨论有限改革。"}
static func greeting(s,who: String) -> Array:
 var text: Array={
  "priest":["疯祭司|海上有火。我记得帆，也记得城墙下面的人……是哪一年？为什么有人说那一年没有海？", "疯祭司|如果让他们再看见我们，谁来保证那些孩子不会再经历一次？"],
  "inspector":["审查官|你说命令有问题，就给我能核对的责任材料。匿名海洋证据可以说明海，却不能替我签一份停捕令。", "审查官|学城完整责任链让材料进入追责程序，正式回执还能节省行动。只有受理还不够，你得看命令是否真的执行。"],
  "king":["国王|你以为我不知道海在哪里？我记得船上的火，也记得是谁守住了这里。", "国王|但如今你要我交出的，远不止一段历史。你准备让谁决定这个王国的边界？"]
 }[who]
 text.append(s.status(who))
 return Lines.lines(text)
static func action(s,id: String) -> Array:
 var text: Array=[]
 if id.begins_with("reconnect_") or id=="restore_market": return Lines.lines([s.consequence(id),stage(s).next])
 match id:
  "archive": text=["航海物品禁售、旧史替换和羽族禁飞的卷宗，引用了同一份王室授权。它们并非互不相干的地方规矩。"]
  "war": text=["你比对军需日期、港口遇袭报告与外部来信。入侵曾经发生，祭司的恐惧有真实来源。", "后来的来信却渐渐中断。这些记录无法证明今天海的另一边仍是同样的敌人。"]
  "device": text=["维护簿记录了仪式、各地共同叙述与边界稳定程度之间的关系。法器能够强化共同信念，却不能独自让所有人相信一个不存在的答案。", "运行图留下了维护通道：停止王室连接不需要取得祭司的保管钥匙，但必须先解除守卫执行禁令的依据。"]
  "chain": text=["你按时间排列战争、授权和后续修订。最初的隐藏措施用于躲避入侵，后来扩大到思想、身份与行动。", "有人一直知道海存在，却把这种知识变成了只有统治者才能持有的权力。责任链核验完成。"]
  "sea_evidence": text=["王城封存的旧港器具、海路尺度与航线记录可以互相核对。你区分实际观察、旧记录和猜测，整理出能交给普通读者检查的材料。", "持有材料仍不等于公众已经读过，传播需要另行安排。"]
  "network": text=["材料被分存到王城的住处和公开阅览点，这些本地节点不能替代集市跨区组织。各节点约定独立核验，不等待王室决定哪些问题可以被提出。", "这条网络可以保存讨论，但未转移的地址仍可能被第五天的查封命中。"]
  "publish": text=["你隐去私人身份，公开器具记录与航线，并现场回应来源问题。读者开始将几地的异常放在一起讨论。", "公告没有暴露具名证人，却让审查者更容易追踪材料的递送方向。"]
  "relay_market","relay_academy": text=["王城的新核验结果送到此前已经读过调查材料的人手中。他们作出回应，原讨论获得新的依据。"]
  "relay_village": text=["带有王城新核验结果的材料抵达渔村。回信提起潮汐、旧船和仍被保存的记录；新的讨论已经发生，才记入认知。"]
  "relay_forest": text=["羽之森的读者收到王城运行记录与海路证据，并寄回他们的疑问。飞行经验与海洋证据被分开说明，共同进入讨论。"]
  "relocate": text=["你把未发材料转移到新的节点，旧地址只留下已经公开的内容。读过消息的人不需要忘记它，未来递送也不再依赖旧址。"]
  "protect_source": text=["你安排了联系人与家属的住处、见面边界和后续联络方式。尚未到期的追查得到处理；已经失去的联系不会凭空恢复。"]
  "bypass": text=["不同节点出示各自保留的认证记录，拒绝把全部副本送到同一个地方。守卫无法靠一份集中查封令同时终止讨论。", "审查官仍不赞同你，但禁令失去了集中执行的条件。"]
  "disconnect": text=["维护通道打开。你依照运行记录中断王室的独占连接，法器仍然存在，但不再由国王单独强化同一种叙述。", "海尚未出现。你还可以决定是否在大典集中释放已有的海洋共识。"]
  "memory": text=["你没有告诉祭司那场战争只是幻觉。你把遇袭报告放在他面前，再摆出禁令与受害者的记录。", "疯祭司|我想让他们活下来。后来，我让他们连问为什么都害怕了。", "他承认记忆中被混在一起的年代，也承认保护的理由不能替每一道后来的命令免责。"]
  "review_plan": text=["居民逐项核对预警、保存与开放安排：谁能查阅运行记录，谁能提出异议，发现危险后如何共同决定。", "他们修正了几处只靠个人承诺的条款，让计划能够在你离开之后继续运行。"]
  "plan": text=["你承诺分散保存知识、让多人监督法器，并用可验证的信息决定逐步开放。", "疯祭司|你不保证海的那边没有危险。你保证的是，不再让一个人的恐惧成为所有人的牢笼。"]
  "handover": text=["祭司将保管钥匙交到你手中，解除王室的独占连接。", "疯祭司|我把选择交出来，不是请你成为另一个只听自己声音的人。", "你获得了法器，尚未决定最终如何使用。"]
  "consent": text=["你说明署名会帮助追责，也可能导致新的协助受限。祭司看完后果，选择亲自确认自己签过的命令。", "疯祭司|别替我删去姓名。但把那些只是执行过搬运的人隐去。"]
  "testimony": text=["祭司逐项确认签署、授权与执行范围。有效责任证言已经形成，下一天末的具名追查也被明确告知。"]
  "original": text=["你从登记簿取得认证命令，核对印章、授权日期和分发编号。这条追责路线不需要公开私人证人的姓名。"]
  "case": text=["审查官签收责任材料，注明必须答复的命令编号。", "审查官|我接受核验，不等于所有禁令已经消失。你要的是停捕，就把执行清单核实到最后一步。"]
  "stay": text=["你逐项核验停捕与暂缓查封的命令。守卫撤下旧名单，传播点收到正式通知。", "改变不再停留在一张受理回执上。"]
  "deal": text=["国王允许一批旧史研究恢复，并交出释放名单。你逐项确认，人已离开拘押处，许可也开始生效。", "国王|到此为止。让他们研究过去，不要再让整个王国面对海。法器仍由王室保管。", "你接受了这份有真实成果、也有限制的交易。后续仍可花1 AP公开解除承诺。"]
  "renounce": text=["你公开说明有限改革不足以替所有人决定边界，解除停止传播的承诺。", "国王收回了对你的合作期待。已经释放的人与已经执行的许可仍被如实记录。"]
  "takeover": text=["你找到将法器与传播中枢转向新持有者的方法。命令的位置空了出来，像是在等你写下自己的名字。", "准备已经完成。你仍可放弃接管，兑现共同监督的承诺。"]
  "final_sea","final_liberation","final_new_king","final_forgetting": text=[s.result_text(),s.report()]
 if not s.finished: text.append(s.consequence(id));text.append(stage(s).next)
 return Lines.lines(text)
static func day_start(s) -> Array:
 var text: Array=s.events.duplicate()
 text.append("王城第%d天，可用%d AP。" % [s.day,s.ap])
 if s.day==3: text.append("王室让人抄送了一份旧战争报告。恐惧是真实的，但它并不能代替对现在的核验。")
 if s.day==4: text.append("国王提出有限改革交易。审查官同时公布：第五天末查封未保护的传播节点。转移、暂缓执行或分散拒绝都能改变结果。")
 if s.day==5: text.append("今晚查封。还有未决具名或联系人风险时，结束当天前请查看手记中的时间。")
 if s.day==6: text.append("定界大典开始。你可以继续补足行动，也可以查看最终选择；海回归或接管需要保留1 AP；确认解放免费。")
 text.append(stage(s).next)
 return Lines.lines(text)
