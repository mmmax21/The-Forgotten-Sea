[gd_scene format=3]

; 物品栏。节点职责写在 scripts/ui/popup/inventory_modal.gd 文件头。
; Icons.png 是 6 列 × 19 行、每格 16×16。
; 关闭是第 3 行第 5 格。左箭头是第 5 行第 5 格，右箭头是第 5 行第 6 格。

[ext_resource type="Script" path="res://scripts/ui/popup/inventory_modal.gd" id="1_inventory"]
[ext_resource type="Texture2D" path="res://assets/Icons.png" id="2_icons"]

[sub_resource type="AtlasTexture" id="AtlasTexture_close"]
atlas = ExtResource("2_icons")
region = Rect2(64, 32, 16, 16)

[sub_resource type="AtlasTexture" id="AtlasTexture_prev"]
atlas = ExtResource("2_icons")
region = Rect2(64, 64, 16, 16)

[sub_resource type="AtlasTexture" id="AtlasTexture_next"]
atlas = ExtResource("2_icons")
region = Rect2(80, 64, 16, 16)

[node name="InventoryModal" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
script = ExtResource("1_inventory")

