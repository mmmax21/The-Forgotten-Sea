extends SceneTree
const State := preload("res://scripts/story/trail2_state.gd")
const Market := preload("res://scripts/story/trail2_market.gd")
const Academy := preload("res://scripts/story/trail2_academy.gd")
const Business := preload("res://scripts/story/trail2_market_business.gd")
const Save := preload("res://scripts/story/trail2_save.gd")
var failures := 0
func check(ok: bool, label: String) -> void:
	if not ok:
		failures += 1
		push_error(label)
func _initialize() -> void:
	call_deferred("run")
func fresh_market():
	var s = State.new()
	for i in 5:
		s.end_day()
	check(Market.enter(s).ok and s.ap == 2, "零成果也可进入集市，路程1 AP")
	s.ap = 3 # 业务规则单元夹具；实际预算由连续旅程和UI验证。
	return s
func m(s, id: String) -> void:
	var r: Dictionary = Market.execute(s, id)
	check(r.ok, id + " : " + r.text)
func b(s, id: String) -> void:
	var r: Dictionary = Business.execute(s, id)
	check(r.ok, id + " : " + r.text)
func run() -> void:
	check_market()
	check_academy()
	check_continuous_journey()
	check_migrations()
	await check_full_ui()
	print("Full MVP checks: ", "PASS" if failures == 0 else "FAIL %d" % failures)
	quit(1 if failures else 0)
func check_market() -> void:
	var s = fresh_market()
	m(s, "qian_help")
	m(s, "xiang_help")
	s.end_day()
	m(s, "qian_material")
	m(s, "xiang_material")
	m(s, "p1_local")
	s.end_day()
	b(s, "copy_single:P1")
	b(s, "contact:cross:P1")
	s.end_day()
	b(s, "deliver:cross:副本1")
	check(s.people.xiang.alert == 55 and s.market.business.delivered.is_empty(), "A55待发不等于送达")
	s.end_day()
	s.end_day()
	check(s.market.business.delivered.size() == 1 and s.market.claims.has("P1"), "10AP基础商队路线")
	check(not Market.execute(s, "dao_help").ok, "结束后不能行动")
	var path := "/tmp/trail2-market-%d.json" % OS.get_process_id()
	check(Save.save_to(path, s, {"selected_group": "qian", "text": "集市结束"}) == OK, "集市存档")
	var saved: Dictionary = Save.load_from(path)
	check(saved.ok and saved.state.to_save_data() == s.to_save_data(), "集市状态完整往返")
	# 公开P2 + 转移 + 商队 13 AP。
	s = fresh_market()
	m(s, "dao_help")
	m(s, "xiang_help")
	s.end_day()
	m(s, "dao_material")
	m(s, "p2_text")
	m(s, "dao_protect")
	s.end_day()
	b(s, "copy_large:P2")
	b(s, "publish:reserve:副本1")
	check(s.people.dao.alert == 65, "公开后沉默保留传播")
	s.end_day()
	check(s.people.dao.alert == 75 and s.market.business.inspection.size() == 1, "第9天名单和A10")
	b(s, "move:print")
	b(s, "contact:cross:P2")
	s.end_day()
	check(not s.market.business.channels.print.closed, "转移后新址保留")
	b(s, "deliver:cross:副本2")
	s.end_day()
	check(s.market.business.delivered.size() == 1 and Business.valid(s, "print") and s.market.business.public_claims.has("P2"), "13AP公开转移商队路线")
	# 具名赶印：T40/A65，次日3AP补救。
	s = fresh_market()
	m(s, "dao_help")
	m(s, "dao_material")
	s.end_day()
	m(s, "p2_text")
	m(s, "dao_protect")
	s.end_day()
	b(s, "copy_rush:P2")
	check(s.people.dao.warning_day == 9 and s.people.dao.trust == 40, "具名赶印预警")
	s.end_day()
	b(s, "repair")
	b(s, "move:print")
	check(s.people.dao.trust == 60 and s.people.dao.alert == 55 and s.people.dao.warning_day == 0, "完整补救")
	s.end_day()
	check(Business.valid(s, "print"), "补救后渠道有效")
	# A60交付失败；已取得材料、已确认主张不回滚。
	s = fresh_market()
	m(s, "qian_help")
	m(s, "xiang_help")
	s.end_day()
	m(s, "qian_material")
	m(s, "xiang_material")
	m(s, "p1_local")
	s.end_day()
	b(s, "copy_single:P1")
	b(s, "contact:cross:P1")
	s.end_day()
	s.people.xiang.alert = 55
	b(s, "deliver:cross:副本1")
	s.end_day()
	s.end_day()
	check(s.market.business.delivered.is_empty() and s.market.business.batches["副本2"].holder == "player", "A60未补救商队退还")
	# 无补救检查：公开回应保留，首告密次日罚一次。
	s = fresh_market()
	m(s, "dao_help")
	m(s, "dao_material")
	s.end_day()
	m(s, "p2_text")
	m(s, "dao_protect")
	s.end_day()
	b(s, "copy_rush:P2")
	s.end_day()
	s.end_day()
	check(s.day == 10 and s.ap == 2 and s.people.dao.reported and s.market.business.channels.print.closed, "日末先告密再查旧址")
	check(s.market.business.public_claims.has("P2") and not Business.valid(s, "print"), "公开回应与当前渠道独立")
	# 村预警N+1，不提前，传话不免费。
	s = State.new()
	for i in 4:
		s.end_day()
	s.people.salt.informed = true
	s.people.salt.alert = 65
	s.refresh_warnings()
	s.end_day()
	Market.enter(s)
	check(s.ap == 2 and s.people.salt.warning_day == 6, "跨区预警不提前扣AP")
	m(s, "messenger_salt")
	check(s.ap == 1 and s.people.salt.alert == 45 and s.people.salt.informed, "信使1AP降20保留知情")
	check(not Market.execute(s, "qian_help").ok and s.ap == 1, "移动与传话后不足2AP，失败不扣费")
	s.end_day()
	check(s.ap == 3 and not s.people.salt.reported, "补救后无处罚")
	# 专业替代不叠加；证言过期不会扣费。
	s = fresh_market()
	m(s, "dao_help")
	check(not Market.execute(s, "dao_pro").ok and s.ap == 1, "专业关系不能叠加")
	for i in 3:
		s.end_day()
	var ap_before: int = s.ap
	check(not Market.execute(s, "xiang_material").ok and s.ap == ap_before, "证言过期不扣费")


func fresh_academy():
	var s = fresh_market()
	for i in 5:
		s.end_day()
	check(Academy.enter(s).ok and s.ap == 2, "零集市收益可进入学城，路程1 AP")
	s.ap = 3 # 学城规则单元夹具，不模拟抵达当天。
	return s
func a(s, id: String) -> void:
	var result: Dictionary = Academy.execute(s, id)
	check(result.ok, id + " : " + result.text)
func check_academy() -> void:
	# 无集市奖励14AP，公开质证+署名+分散传播。
	var s = fresh_academy()
	for id in ["mo_help", "versions_mo", "verify"]: a(s, id)
	s.end_day()
	for id in ["er_help", "execution_er"]: a(s, id)
	s.end_day()
	for id in ["gao_help", "command_gao"]: a(s, id)
	s.end_day()
	for id in ["trace", "distribute_mo"]: a(s, id)
	s.end_day()
	for id in ["sign", "challenge"]: a(s, id)
	s.end_day()
	check(s.academy.finished and s.academy.ending == "liberation" and not s.academy.flags.sea_returned, "14AP公开解放，不冒充海回归")
	check(s.academy.report.contains("多个参与机构") and s.academy.report.contains("高帽子"), "制度表现与人物后日谈")
	# 正式回应+留档路线14AP。
	s = fresh_academy()
	for id in ["mo_help", "versions_mo", "er_help"]: a(s, id)
	s.end_day()
	for id in ["execution_er", "gao_help"]: a(s, id)
	s.end_day()
	for id in ["command_gao", "verify", "trace"]: a(s, id)
	s.end_day()
	for id in ["distribute_mo", "response"]: a(s, id)
	s.end_day()
	a(s, "file")
	s.end_day()
	check(s.academy.ending == "liberation", "正式留档解放路线")
	# 无海洋物证继承，馆藏补证+跨区补发12AP。
	s = fresh_academy()
	for id in ["mo_help", "versions_mo", "verify"]: a(s, id)
	s.end_day()
	for id in ["museum_mo", "observations_mo"]: a(s, id)
	check(s.people.mo.alert == 55, "馆藏协助额外A5")
	s.end_day()
	a(s, "distribute_mo")
	check(s.people.mo.alert == 60 and not Academy.execute(s, "resend_mo").ok, "分散后沉默不能补发")
	a(s, "mo_protect")
	s.end_day()
	a(s, "observe_first")
	check(not Academy.execute(s, "observe_second").ok, "不可同日两次观测")
	a(s, "resend_mo")
	check(not s.publications.any(func(e): return e.region == "market"), "补发未送达不算异地传播")
	s.end_day()
	a(s, "observe_second")
	check(s.academy.flags.has("P4") and s.ap == 2, "第15天正常行动形成P4")
	s.end_day()
	check(s.academy.ending == "sea" and not s.academy.flags.liberation, "12AP海回归不冒充自由")
	# 无前期奖励，15AP隐藏线+P3+新建有效渠道。
	s = fresh_academy()
	for id in ["mo_help", "versions_mo", "early"]: a(s, id)
	s.end_day()
	for id in ["er_help", "execution_er", "running"]: a(s, id)
	s.end_day()
	for id in ["gao_help", "command_gao"]: a(s, id)
	s.end_day()
	for id in ["verify", "trace", "negotiate"]: a(s, id)
	s.end_day()
	for id in ["distribute_mo", "artifact"]: a(s, id)
	s.end_day()
	check(s.academy.ended and not s.academy.finished, "有法器等待主动处置")
	var payload: Dictionary = s.to_save_data()
	check(Academy.finish(s, "take").ok and s.academy.ending == "king", "有效渠道可主动接管")
	check(not Academy.finish(s, "return").ok, "终局不能重复改选")
	var keep = State.new()
	check(keep.restore_save_data(payload), "终局前状态可恢复")
	check(Academy.finish(keep, "keep").ok and keep.academy.ending == "forgetting", "保留法器不自动接管")
	var no_channel = State.new()
	no_channel.restore_save_data(payload)
	no_channel.people.mo.alert = 60
	check(not Academy.finish(no_channel, "take").ok and not no_channel.academy.finished, "终局有效渠道失效禁止接管")
	check(Academy.finish(no_channel, "return").ok and no_channel.academy.report.contains("交还疯祭司"), "交还写入遗忘结局")
	# 第14天定位+保全3AP；第15天不能凭编号补领。
	s = fresh_academy()
	for i in 3: s.end_day()
	a(s, "locate_versions")
	a(s, "save_versions")
	check(s.ap == 0, "第14天现定位+保全完整3AP")
	s.end_day()
	check(not Academy.execute(s, "get_execution").ok and not Academy.execute(s, "save_execution").ok, "销毁后不补领")
	check(Academy.has(s, "versions"), "抢救底稿不被销毁")
	# 终日新预警保留16，不提前报告。
	s.people.er.trust = 40
	s.people.er.alert = 65
	s.people.er.informed = true
	s.refresh_warnings()
	s.end_day()
	check(s.people.er.warning_day == 16 and not s.people.er.reported and s.academy.report.contains("第16天"), "第16天风险进入后日谈")
	var path := "/tmp/trail2-ending-%d.json" % OS.get_process_id()
	check(Save.save_to(path, s, {"selected_group": "archive", "text": s.academy.report}) == OK, "终局存档")
	var loaded := Save.load_from(path)
	check(loaded.ok and loaded.state.to_save_data() == s.to_save_data(), "终局与未决风险往返一致")

func check_full_ui() -> void:
	var scene = load("res://scenes/trail2.tscn").instantiate()
	scene.persistence_enabled = false
	root.add_child(scene)
	await process_frame
	for i in 5:
		scene.state.end_day()
	scene._refresh()
	scene._ask_end_day()
	scene.modal._select("enter_market")
	check(scene.state.day == 6 and scene.selected_group == "research", "UI进入集市")
	scene.get_node("Design/CharacterRail/Cards").get_child(0).pressed.emit(0)
	scene._preview_market("qian_help")
	scene.modal._select("market_execute:qian_help")
	check(scene.state.ap == 0 and scene.state.people.qian.trust == 60, "UI集市行动")
	for i in 5: scene.state.end_day()
	scene._refresh()
	scene._ask_end_day()
	scene.modal._select("enter_academy")
	check(scene.state.day == 11 and scene.selected_group == "archive", "UI进入学城")
	scene.get_node("Design/CharacterRail/Cards").get_child(0).pressed.emit(0)
	scene._preview_academy("mo_help")
	scene.modal._select("academy_execute:mo_help")
	check(scene.state.ap == 1 and scene.state.people.mo.trust == 60, "UI学城行动")
	for i in 5: scene.state.end_day()
	scene._refresh()
	scene._ask_end_day()
	check(scene.modal.visible and scene.state.academy.finished and scene.state.day == 15, "UI十五天至终局")
	for extent in [Vector2i(1280, 720), Vector2i(1920, 1080)]:
		root.size = extent
		await process_frame
		await process_frame
		var panel: Control = scene.modal.get_child(1)
		var rect := panel.get_global_rect()
		check(rect.position.x >= 0 and rect.position.y >= 0 and rect.end.x <= extent.x + 1 and rect.end.y <= extent.y + 1, "终局弹窗在窗口范围内：%s" % extent)
	scene.queue_free()
	await process_frame


func check_continuous_journey() -> void:
	var s = State.new()
	for id in ["feed", "listen", "repair"]: check(s.execute(id).ok, "连续渔村" + id)
	s.end_day()
	check(s.execute("protect").ok and s.travel("ruins").ok, "第2天安置并前往遗迹")
	s.end_day()
	for id in ["survey", "clear", "search"]: check(s.execute(id).ok, "连续遗迹" + id)
	s.end_day()
	check(s.travel("fishing_village").ok, "第4天返回村庄")
	check(s.execute("identify").ok and s.execute("relic").ok, "第4天取得两份确认物证")
	s.end_day()
	check(s.execute_material("record_self", "", ["relic"]).ok, "第5天制作记录")
	check(s.execute_material("spread", "salt", ["record_1"]).ok and s.ap == 0, "含往返15AP完成渔村")
	s.end_day()
	check(Market.enter(s).ok and s.food == 0 and s.inventory.record_1.holder == "salt", "连续游玩真实继承")
	m(s, "dao_help")
	s.end_day()
	for id in ["dao_material", "p2_text", "dao_protect"]: m(s, id)
	s.end_day()
	b(s, "copy_small:P2")
	b(s, "publish:local:副本1")
	s.end_day()
	m(s, "qian_help")
	m(s, "qian_material")
	s.end_day()
	m(s, "p1_antique")
	s.end_day()
	check(Academy.enter(s).ok and Academy.has(s, "verified"), "同批P2免重复版本核验")
	check(not Academy.execute(s, "verify").ok and s.ap == 2, "免核验不重复收费")
	for id in ["gao_pro", "command_gao"]: a(s, id)
	s.end_day()
	check(s.academy.locations.has("execution"), "有效P2小范围渠道提供编号")
	for id in ["mo_help", "get_execution", "trace"]: a(s, id)
	s.end_day()
	for id in ["distribute_mo", "sign"]: a(s, id)
	s.end_day()
	a(s, "observations_mo")
	a(s, "observe_first")
	var path := "/tmp/trail2-continuous-%d.json" % OS.get_process_id()
	check(Save.save_to(path, s, {"selected_group": "archive", "text": "第14天观测"}) == OK, "连续旅程中途存档")
	var loaded := Save.load_from(path)
	check(loaded.ok, "连续旅程中途读取")
	s = loaded.state
	s.end_day()
	for id in ["observe_second", "challenge"]: a(s, id)
	s.end_day()
	check(s.academy.ending == "sea" and s.academy.flags.sea_returned and s.academy.flags.liberation, "全程实际行动同时海回归和解放")
	check(s.publications.any(func(e): return e.region == "village") and s.academy.report.contains("盐嫂"), "三地历史及后日谈保留")

func check_migrations() -> void:
	var path := "/tmp/trail2-legacy-%d.json" % OS.get_process_id()
	var s = State.new()
	s.execute("feed")
	var data: Dictionary = s.to_save_data()
	data.erase("market")
	data.erase("academy")
	var payload := JSON.stringify({"state": data, "view": {"selected_group": "salt", "text": "旧版进度"}})
	var file := FileAccess.open(path, FileAccess.WRITE)
	file.store_string(JSON.stringify({"game": "trail2", "version": 1, "payload": payload, "checksum": payload.sha256_text()}))
	file.close()
	var loaded := Save.load_from(path)
	check(loaded.ok and loaded.state.ap == 2 and loaded.state.food == 1 and loaded.state.market.is_empty(), "版本1存档保留真实进度")
	s = fresh_market()
	m(s, "dao_help")
	data = s.to_save_data()
	data.erase("academy")
	data.market.erase("business")
	payload = JSON.stringify({"state": data, "view": {"selected_group": "dao", "text": "旧版集市进度"}})
	file = FileAccess.open(path, FileAccess.WRITE)
	file.store_string(JSON.stringify({"game": "trail2", "version": 2, "payload": payload, "checksum": payload.sha256_text()}))
	file.close()
	loaded = Save.load_from(path)
	check(loaded.ok and loaded.state.ap == 1 and loaded.state.people.dao.trust == 60 and loaded.state.market.business.batches.is_empty(), "版本2升级不赠送业务成果或重置人物")
